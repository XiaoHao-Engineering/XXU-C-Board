build_*/
build-*/
cmake-build-*/
out/
_baseline_tmp/

# ---- 编译中间件与最终产物 ----
*.o
*.obj
*.elf
*.hex
*.bin
*.map
*.list
*.su
*.d
*.a.tmp

# ---- 调试器 / 工具输出 ----
*.log
*_log.txt
gdbClient_log.txt
jlink_log.txt
RTT*.txt
JScope*.jscope

# ---- 编辑器 / 操作系统杂物 ----
.vscode/ipch/
.vscode/*.log
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# ---- Office 临时锁文件（docs 里生成 docx 时会冒出来）----
